  <ifrs:FinancialAssetsThatAreIndividuallyDeterminedToBeImpairedFairValueOfCollateralHeldAndOtherCreditEnhancements contextRef="Q01I_InformacionRevelarActivosFinancierosMoraDeterioradosDeterioroEje_FinancialAssetsNeitherPastDueNorImpairedMember" unitRef="COP" decimals="0">0</ifrs:FinancialAssetsThatAreIndividuallyDeterminedToBeImpairedFairValueOfCollateralHeldAndOtherCreditEnhancements>
