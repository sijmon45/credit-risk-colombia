  <ifrs:AnalysisOfCreditExposuresUsingInternalCreditGradingSystemExplanatory contextRef="Q04D_C_CategoriasActivosFinancierosEje_LoansAndReceivablesCategoryMember">No aplica</ifrs:AnalysisOfCreditExposuresUsingInternalCreditGradingSystemExplanatory>
