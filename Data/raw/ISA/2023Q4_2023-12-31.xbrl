  <co-sfc-core:SaldoPatrimonioPGCAAnteriores decimals="0" contextRef="Saldo_co-sfc-core_SaldoPatrimonioPGCAAnterioresTabla_co-sfc-core_SaldoMiembro_5_6_ACT" unitRef="COP">7447541860</co-sfc-core:SaldoPatrimonioPGCAAnteriores>
