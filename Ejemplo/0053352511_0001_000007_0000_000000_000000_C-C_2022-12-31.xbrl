  <ifrs:ChangesInExposureToRisk contextRef="Q01D_TypesOfRisksAxis_ResidualValueRiskMember">No Apica</ifrs:ChangesInExposureToRisk>
  <ifrs:ChangesInExposureToRisk contextRef="Q01D_TypesOfRisksAxis_OtherPriceRiskMember">No aplica</ifrs:ChangesInExposureToRisk>
  <ifrs:ChangesInExposureToRisk contextRef="Q01D_TypesOfRisksAxis_MarketRiskMember">No aplica</ifrs:ChangesInExposureToRisk>
