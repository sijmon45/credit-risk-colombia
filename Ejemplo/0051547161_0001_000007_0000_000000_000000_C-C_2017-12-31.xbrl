  <ifrs:FinancialAssetsThatAreIndividuallyDeterminedToBeImpairedFairValueOfCollateralHeldAndOtherCreditEnhancements contextRef="Q01I_InformacionRevelarActivosFinancierosMoraDeterioradosDeterioroEje_FinancialAssetsIndividuallyAssessedForCreditLossesMember" unitRef="COP" decimals="0">7713569</ifrs:FinancialAssetsThatAreIndividuallyDeterminedToBeImpairedFairValueOfCollateralHeldAndOtherCreditEnhancements>
