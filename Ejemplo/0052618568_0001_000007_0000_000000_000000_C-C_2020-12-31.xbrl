  <ifrs:AnalysisOfFinancialAssetsThatAreIndividuallyDeterminedToBeImpaired contextRef="Q04D_C_InformacionRevelarActivosFinancierosMoraDeterioradosImporteEje_CarryingAmountMember">No aplica</ifrs:AnalysisOfFinancialAssetsThatAreIndividuallyDeterminedToBeImpaired>
